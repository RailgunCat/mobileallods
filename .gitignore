# Original resources and working notes stay local; generated HD art is tracked.
/analysis/
/build/
/godot/data/*
!/godot/data/hd/
/godot/data/hd/*
!/godot/data/hd/icons/
!/godot/data/hd/README.txt
/godot/art/*
!/godot/art/ui/
!/godot/art/concepts/
/godot/art/ui/*
!/godot/art/ui/hd-menu-v1/
!/godot/art/ui/hd-town-v1/
/godot/art/concepts/*
!/godot/art/concepts/.gdignore
!/godot/art/concepts/README.md
!/godot/art/concepts/hd-icons-v1/
!/godot/art/concepts/hd-management-v2/
!/godot/art/concepts/hd-menu-v1/
!/godot/art/concepts/hd-desktop-ui-v1/
!/godot/art/concepts/hd-tagrim-sprites-v1/
!/godot/art/concepts/hd-world-v1/
/godot/builds/
/godot/export_templates/
/docs/internal/
/.agents/
/AGENTS.md
/docs/skill-sources.json

# Original/reference media, audio, fonts, archives and packaged games stay local.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.tga
*.ico
*.cur
*.ani
*.svg
*.psd
*.ase
*.aseprite
*.blend
*.wav
*.ogg
*.mp3
*.flac
*.mid
*.midi
*.ttf
*.otf
*.woff*
*.jar
*.zip
*.rar
*.7z
*.tar
*.gz
*.exe
*.dll
*.pck
*.apk
*.aab

# Generated HD assets and their concept masters; reference images stay ignored.
!/godot/data/hd/icons/*.png
!/godot/art/ui/hd-menu-v1/*.png
!/godot/art/ui/hd-town-v1/*.png
!/godot/art/concepts/hd-icons-v1/*.png
!/godot/art/concepts/hd-management-v2/*.png
!/godot/art/concepts/hd-menu-v1/*.png
!/godot/art/concepts/hd-desktop-ui-v1/*.png
!/godot/art/concepts/hd-tagrim-sprites-v1/*.png
!/godot/art/concepts/hd-world-v1/*.png

# README previews are documentation, not source game assets.
!/docs/screenshots/combat-crt-off.png
!/docs/screenshots/combat-crt-on.png

# Godot-generated caches; script/shader .uid files are source metadata.
**/.godot/
*.import
*.tmp
*.log
__pycache__/
*.py[cod]
*.class

# Machine-specific editor state and credentials.
/.vscode/
/.idea/
/.codex/
.env
.env.*
!.env.example
export_credentials.cfg
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
