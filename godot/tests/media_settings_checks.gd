extends RefCounted
const Settings = preload("res://scripts/gameplay/game_settings.gd")
const Ids = preload("res://scripts/gameplay/game_ids.gd")

func run(root, checks) -> void:
	var path: String = "user://media-settings-check-%d.cfg" % Time.get_ticks_usec()
	var config := ConfigFile.new()
	config.set_value("audio", "music_enabled", false)
	config.save(path)
	var migrated := Settings.new()
	migrated.path = path
	migrated.load_settings()
	checks.check(not migrated.values["music_enabled"] and migrated.values["music_volume"] == 32 and migrated.values["sfx_enabled"] and not migrated.values["hd_icons"], "old music preference migrates with new defaults")
	config.set_value("audio", "music_volume", 999)
	config.set_value("audio", "sfx_volume", "broken")
	config.set_value("graphics", "hd_icons", "false")
	config.save(path)
	migrated.load_settings()
	checks.check(migrated.values["music_volume"] == 100 and migrated.values["sfx_volume"] == 65 and not migrated.values["hd_icons"], "settings validate types and clamp volume")
	DirAccess.remove_absolute(path)
	var original_path: String = root.preferences.path
	var original: Dictionary = root.preferences.values.duplicate()
	root.preferences.path = path
	root._restart(false)
	root.preferences.update("music_enabled", true, false)
	root.preferences.update("music_volume", 40, false)
	root.preferences.update("sfx_enabled", true, false)
	root.preferences.update("sfx_volume", 65, false)
	root.preferences.update("hd_icons", false, false)
	checks.check(root.sound_effects.streams.size() == 183 and root.sound_effects.voices.size() == 12, "selected WAV pack decodes into a bounded pool")
	checks.check(root.ui_icons.portraits.size() == 24 and root.ui_icons.spells.size() == 16, "all HD portrait and spell IDs load as native textures")
	for kind in range(Ids.UnitKind.TAGRIM, Ids.UnitKind.POISONED_TROLL + 1):
		root.preferences.update("hd_icons", true, false)
		var image_id: int = int(root.metadata["portrait_images" if kind in Ids.HERO_TYPES else "unit_portrait_images"][kind])
		checks.check(root.ui_icons.actor_portrait(kind, root.metadata) == root.ui_icons.portraits[image_id], "HD battle portrait identifies unit type %d rather than a shared dialogue ID" % kind)
		root.preferences.update("hd_icons", false, false)
		checks.check(root.ui_icons.actor_portrait(kind, root.metadata) == root.view.textures[int(root.metadata["portrait_images"][kind])], "HD off preserves the original portrait for unit type %d" % kind)
	root.preferences.update("hd_icons", true, false)
	var bat_portrait: Texture2D = root.ui_icons.portraits[212]
	root.ui_icons.portraits.erase(212)
	checks.check(root.ui_icons.actor_portrait(Ids.UnitKind.BAT, root.metadata) == root.view.textures[212], "missing HD bat portrait falls back to the original bat, never a mage")
	root.ui_icons.portraits[212] = bat_portrait
	root.preferences.update("hd_icons", false, false)
	var legacy: Texture2D = root.ui_icons.portrait(16)
	var old_spell: Texture2D = root.ui_icons.spell(0)
	checks.check(legacy == root.view.textures[16] and old_spell is AtlasTexture, "HD off uses the exact original resources")
	root._show_game_menu()
	root.game_menu.selected = Ids.GameMenuChoice.SETTINGS
	root.game_menu.confirm()
	checks.check(root.game_menu.settings_open and root.game_menu.regions.size() == 6, "settings expose independent music, SFX, HD and CRT controls")
	root.game_menu.settings_selected = 1
	root.game_menu.handle_settings_key(KEY_RIGHT)
	checks.check(root.preferences.values["music_volume"] == 45 and is_equal_approx(root.music.player.volume_linear, 0.45) and root.preferences.values["sfx_volume"] == 65, "keyboard music volume updates only music")
	var click := InputEventMouseButton.new()
	click.button_index = MOUSE_BUTTON_LEFT
	click.pressed = true
	click.position = root.game_menu.screen_origin + Vector2(120, 176) * root.game_menu.screen_scale
	root.game_menu._gui_input(click)
	checks.check(root.preferences.values["sfx_volume"] == 50 and root.preferences.values["music_volume"] == 45, "mouse slider updates SFX independently")
	var drag := InputEventMouseMotion.new()
	drag.button_mask = MOUSE_BUTTON_MASK_LEFT
	drag.position = root.game_menu.screen_origin + Vector2(200, 176) * root.game_menu.screen_scale
	root.game_menu._gui_input(drag)
	checks.check(root.preferences.values["sfx_volume"] == 100, "volume slider supports dragging to its endpoint")
	root.game_menu.settings_selected = 2
	root.game_menu.confirm()
	checks.check(not root.preferences.values["sfx_enabled"] and not root.sound_effects.play_clip("units/sword.wav") and root.preferences.values["sfx_volume"] == 100, "mute stops SFX and retains selected volume")
	root.game_menu.confirm()
	root.game_menu.settings_selected = 4
	root.game_menu.confirm()
	checks.check(root.ui_icons.portrait(16) != legacy and root.ui_icons.spell(0) == root.ui_icons.spells[0], "HD switch changes portraits and spells immediately")
	for id in root.ui_icons.portraits:
		var texture: Texture2D = root.ui_icons.portraits[id]
		var original_size: Vector2 = root.view.textures[id].get_size()
		checks.check(is_equal_approx(texture.get_width() / float(texture.get_height()), original_size.x / original_size.y), "HD portrait %d preserves the original canvas aspect" % id)
	checks.check(root.ui_icons.portrait(12) == root.view.textures[12], "unmapped icons fall back to the original texture")
	var saved_hd: Texture2D = root.ui_icons.portraits[16]
	root.ui_icons.portraits.erase(16)
	checks.check(root.ui_icons.portrait(16) == legacy, "missing individual HD resource falls back without changing the setting")
	root.ui_icons.portraits[16] = saved_hd
	var restored := Settings.new()
	restored.path = path
	restored.load_settings()
	checks.check(restored.values == root.preferences.values, "all six preferences survive a fresh settings instance")
	root.game_menu.back()
	root.game_menu.back()
	root._demo_battle(true)
	root.battle_overlay.acknowledge()
	root.battle.select(1001)
	root._choose_action("magic", -1)
	var spell_id: String = str(root.action_bar.buttons.keys()[0])
	checks.check(root.action_bar.buttons[spell_id].icon == root.ui_icons.spells[int(spell_id)], "battle spell buttons use mapped HD icons")
	root.preferences.update("hd_icons", false, false)
	checks.check(root.action_bar.submenu and root.action_bar.buttons[spell_id].icon is AtlasTexture and root.ui_icons.portrait(16) == legacy, "live HD off rebuilds spell icons and preserves the open spell menu")
	var heard: Array[String] = []
	var listener: Callable = func(clip: String): heard.append(clip)
	root.sound_effects.played.connect(listener)
	root.sound_effects.stop_all()
	root.sound_effects.pause_world(false)
	var rng: Dictionary = root.battle.rng.snapshot()
	for spell in range(Ids.Spell.COUNT):
		root.sound_effects.stop_all()
		root.battle.spell_impact.emit(spell, Vector2i.ZERO, 0)
	checks.check(heard.size() == 15 and root.battle.rng.snapshot() == rng, "all fifteen spell impact events route to audio without consuming combat RNG")
	root.sound_effects.stop_all()
	root.sound_effects.play_clip("units/sword.wav")
	root.sound_effects.pause_world(true)
	checks.check(root.sound_effects.voices[0].stream_paused, "world audio pauses with game menus")
	root.sound_effects.play_clip("click_ok.wav", false)
	checks.check(not root.sound_effects.voices[1].stream_paused, "UI audio remains audible while world audio is paused")
	root.sound_effects.pause_world(false)
	checks.check(not root.sound_effects.voices[0].stream_paused, "closing menu resumes world audio")
	root.sound_effects.stop_all()
	var count: int = 0
	for clip: String in root.sound_effects.streams:
		if root.sound_effects.play_clip(clip): count += 1
		if count == 12: break
	checks.check(count == 12 and not root.sound_effects.play_clip("units/sword.wav"), "voice limit bounds simultaneous effects")
	root.preferences.update("sfx_enabled", false, false)
	checks.check(root.sound_effects.voices.all(func(voice): return not voice.playing), "disabling SFX stops every active voice")
	root.preferences.update("sfx_enabled", true, false)
	root.preferences.update("sfx_volume", 0, false)
	checks.check(not root.sound_effects.play_clip("units/sword.wav") and root.music.player.volume_linear > 0, "zero SFX volume is silent while music remains independent")
	root.preferences.update("sfx_volume", 65, false)
	root._demo_battle()
	root.battle_overlay.acknowledge()
	heard.clear()
	root.sound_effects.stop_all()
	checks.check(root.battle.attack(1004), "audio fixture queues a real physical attack")
	checks.check(heard.is_empty(), "ordering an attack does not play its impact early")
	for tick in range(500):
		root._process(0.062)
		if root.battle.current.is_empty() and root.battle.queue.is_empty(): break
	checks.check("units/sword.wav" in heard and heard.any(func(clip): return clip.begins_with("units/soft")), "actual windup and hit each emit their matching sound")
	root.sound_effects.stop_all()
	heard.clear()
	root.battle.presentation_event.emit({"event": "death", "actor": root.session.party[1].instance_id})
	checks.check(heard.size() == 1 and heard[0].begins_with("units/deadf"), "Li uses the female death variant")
	root.sound_effects.stop_all()
	heard.clear()
	root.battle.presentation_event.emit({"event": "death", "actor": root.session.hero.instance_id})
	checks.check(heard.size() == 1 and not heard[0].begins_with("units/deadf"), "male characters do not select female sound variants")
	var before: int = heard.size()
	for frame in range(20): root._refresh_visuals()
	checks.check(heard.size() == before, "visual refresh never replays combat effects")
	root._restart(false)
	checks.check(root.sound_effects.voices.all(func(voice): return not voice.playing), "restart clears pending sound playback")
	root._show_main_menu(true)
	var key := InputEventKey.new()
	key.pressed = true
	key.physical_keycode = KEY_F2
	root._input(key)
	checks.check(root.game_menu.settings_open and not root.main_menu.visible and root.session.mode == &"main_menu", "title F2 opens the shared settings without starting a game")
	root.game_menu.back()
	checks.check(root.main_menu.visible and not root.game_menu.visible, "closing title settings returns to the title")
	checks.check(root.main_menu.regions.size() == 3 and root.main_menu.regions.all(func(region): return region.logical_rect.position.y >= 178), "title artwork has no settings overlay or hidden hotspot")
	root.main_menu.navigate(-1)
	checks.check(root.main_menu.selected == Ids.TitleChoice.SETTINGS, "title carousel reaches Settings with keyboard navigation")
	root.main_menu.confirm()
	checks.check(root.game_menu.settings_open and not root.main_menu.visible, "title carousel Settings opens the shared options")
	root.game_menu.back()

	root._restart(false)
	root.sound_effects.pause_world(false)
	root.preferences.update("sfx_enabled", true, false)
	root.preferences.update("sfx_volume", 65, false)
	heard.clear()
	for tick in range(4): root.sound_effects.walk(0, 4, false)
	checks.check(heard.is_empty(), "footstep cadence waits for actual travelled distance")
	root.sound_effects.walk(0, 4, false)
	checks.check(heard == ["town/shop/step1.wav"], "surface footsteps start with the first selected short clip")
	for tick in range(5): root.sound_effects.walk(0, 4, false)
	checks.check(heard == ["town/shop/step1.wav", "town/shop/step2.wav"], "surface footsteps alternate left and right")
	var count_before: int = heard.size()
	root.sound_effects.walk(0, 0, false)
	root.sound_effects.walk(0, 500, false)
	checks.check(heard.size() == count_before, "stationary positions and teleports never produce footsteps")
	root.sound_effects.stop_all()
	heard.clear()
	for tick in range(10): root.sound_effects.walk(0, 4, true)
	checks.check(heard == ["town_kaarg/ksteps1.wav", "town_kaarg/ksteps2.wav"], "dungeons use the second selected footstep pair")
	root.sound_effects.pause_world(true)
	count_before = heard.size()
	for tick in range(5): root.sound_effects.walk(0, 4, true)
	checks.check(heard.size() == count_before, "paused menus suppress new footsteps")
	root.sound_effects.pause_world(false)
	root.preferences.update("sfx_enabled", false, false)
	for tick in range(5): root.sound_effects.walk(0, 4, false)
	checks.check(heard.size() == count_before, "the common SFX toggle also mutes footsteps")
	root.preferences.update("sfx_enabled", true, false)
	root.sound_effects.stop_all()
	heard.clear()
	var world_rng: Dictionary = root.session.world_rng.snapshot()
	root.exploration.set_direction(Vector2i.LEFT)
	root.exploration.advance(0.062 * 8)
	checks.check(heard.any(func(clip): return clip.begins_with("town/shop/step")), "real exploration movement emits the selected footstep sound")
	root.exploration.stop()
	count_before = heard.size()
	root.exploration.advance(0.062 * 8)
	checks.check(heard.size() == count_before, "stopping exploration immediately stops step emission")
	var terrain: PackedByteArray = root.session.collision.terrain.duplicate()
	root.session.collision.terrain.fill(1)
	var position: Vector2 = root.session.hero.position_pixels
	root.exploration.set_direction(Vector2i.LEFT)
	root.exploration.advance(0.062 * 8)
	checks.check(root.session.hero.position_pixels == position and heard.size() == count_before, "pressing into blocked terrain is silent")
	root.session.collision.terrain = terrain
	checks.check(root.session.world_rng.snapshot() == world_rng, "walking sound selection does not advance world RNG")
	root.sound_effects.played.disconnect(listener)
	for name: String in original: root.preferences.update(name, original[name], false)
	root.preferences.path = original_path
	DirAccess.remove_absolute(path)
	root._restart(false)
