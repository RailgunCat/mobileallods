static func status_icon(icon: StatusIcon) -> Dictionary:
	var action_frames := {StatusIcon.MOVE: MenuAction.MOVE, StatusIcon.ATTACK: MenuAction.ATTACK, StatusIcon.DEFEND: MenuAction.DEFEND, StatusIcon.SHOOT: MenuAction.SHOOT}
	if action_frames.has(icon): return {"atlas": ImageId.ACTION_ATLAS, "frame": action_frames[icon]}
	return {"atlas": ImageId.SPELL_ATLAS, "frame": 15 if icon == StatusIcon.STUN else icon - StatusIcon.FIRE_ARROW}
